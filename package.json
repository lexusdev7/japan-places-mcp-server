{
  "name": "mcp-japan-places",
  "version": "2.0.0",
  "description": "MCP server for the Japan Places API: municipality census for 1,917 municipalities, POI category counts for all 47 prefectures, station catchments (60-station sample), and 13 live signals.",
  "author": "Lexus",
  "license": "CDLA-Permissive-2.0 AND Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "mcp-japan-places": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "SYNC.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "generate": "python3 tools/generate_mcp.py",
    "check-drift": "python3 tools/check_drift.py"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "japan",
    "poi",
    "points-of-interest",
    "geodata",
    "opendata"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexusdev7/japan-places-mcp-server.git"
  },
  "homepage": "https://japan-places.local-connect-design.trade"
}
